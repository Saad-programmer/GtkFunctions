void add_to_header_bar_end(header_bar *hdb, GtkWidget *widget) {
    if (hdb && hdb->header_bar && widget) {
        gtk_header_bar_pack_end(GTK_HEADER_BAR(hdb->header_bar), widget);
    }
}
